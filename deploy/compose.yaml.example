# Story Bible - TrueNAS SCALE Custom App template. This file is the
# generic, tracked-in-git template - DO NOT edit it in place with real
# values and DO NOT reference this filename directly for a persistent
# checkout (see deploy/README.md). It exists as:
#
#   - Something to paste into TrueNAS UI -> Apps -> Discover Apps ->
#     (top-right) Install via YAML, editing the values below IN THAT
#     PASTED TEXT (dataset path, STORYBIBLE_TOKEN, etc.) before installing.
#     That dialog doesn't accept a companion file (#36), hence everything
#     being inline in environment: below rather than an env_file:.
#   - The source for a ONE-TIME `cp deploy/compose.yaml.example
#     deploy/compose.yaml` on a persistent checkout (e.g. for
#     deploy/update.sh's `git pull`). deploy/compose.yaml is gitignored -
#     edit real values into THAT copy, never into this template. Keeping
#     the real file untracked is exactly what fixes #38: a tracked
#     deploy/compose.yaml with real values edited into it collides with
#     every future `git pull`, since git won't silently overwrite local
#     changes to a tracked file - which is what happened there.
#
# Either way: the image itself is built locally on the NAS by
# deploy/update.sh, not pulled from a registry - hence pull_policy: never,
# and why there's no `image:` tag with a registry prefix.
services:
  storybible:
    image: story-bible:current
    pull_policy: never
    restart: unless-stopped
    user: "568:568"          # TrueNAS SCALE's "apps" user - matches the dataset's owner
    ports:
      # host:container - port 8000 on this NAS is already used elsewhere.
      # This publishes PLAIN HTTP on every interface of the NAS, and the app's
      # token / sign-in bearer crosses the LAN unencrypted to anyone who can
      # reach it directly instead of through the reverse proxy: restrict who
      # can reach this port to the proxy only - see deploy/README.md,
      # "Network exposure".
      - "2285:8000"
    volumes:
      # The dataset itself, mounted directly as /data - not a subdirectory
      # under it. A subdirectory here wouldn't exist yet on first deploy,
      # so Docker would auto-create it owned by root, and the container
      # (running as 568:568) couldn't write to it. Mounting the dataset
      # root means the chown in deploy/README.md's step 1 is the only
      # ownership step needed. Adjust the path to your actual pool/dataset.
      - /mnt/tank/apps/storybible:/data
    environment:
      # Auth (see .env.example for what each of these does). Left blank,
      # STORYBIBLE_TOKEN is honestly wide open - app/main.py reports
      # "auth": false at /api/health and skips the check entirely - rather
      # than shipping a non-blank placeholder that would report "auth":
      # true while actually being a publicly-known value (this file is on
      # GitHub) anyone could authenticate with. Set a real one before
      # anything sensitive goes in:
      #   python -c "import secrets; print(secrets.token_urlsafe(32))"
      AUTH_MODE: token
      STORYBIBLE_TOKEN: ""
      ENTRA_TENANT_ID: ""
      ENTRA_CLIENT_ID: ""
      # REQUIRED for AUTH_MODE=entra (or "*" to allow everyone Entra lets in),
      # and LEGACY_OWNER_OID is who owns pre-sign-in series - see .env.example.
      ALLOWED_OIDS: ""
      LEGACY_OWNER_OID: ""
      # Comma-separated Entra object ids (never emails) of the administrators: they
      # get the Admin button (registered users, usage, block/unblock) and are never
      # auto-deleted for inactivity. Recommended: just you. Blank = no admin.
      ADMIN_OIDS: ""
      # "allowlist" (default) or "open" (any Microsoft account) - see .env.example
      # before changing it. BLOCKED_TENANTS: tenant ids refused in open mode.
      SIGNUP_MODE: "allowlist"
      BLOCKED_TENANTS: ""
      # Optional https links shown before first sign-in (#91).
      PRIVACY_URL: ""
      TERMS_URL: ""
      # Bump when the privacy policy / terms change: everyone must accept again (#111).
      POLICY_VERSION: "1.0"
      # The pane's "Log Issue"/"Log Suggestion" buttons (#22) - a
      # fine-grained GitHub PAT, scoped to just this repo, Issues: write
      # only. Blank means filing returns 503 rather than crashing.
      GITHUB_FEEDBACK_TOKEN: ""
      # The Synology reverse proxy's LAN IP - blank trusts nothing (127.0.0.1 default).
      FORWARDED_ALLOW_IPS: ""
      # Backup schedule/monitoring (#5/#17) and log timestamps.
      TZ: "Australia/Sydney"
      # Outgoing mail for the inactive-account notices (#113). Blank = no emails;
      # accounts are still deleted on schedule. Gmail: an app password, see
      # deploy/README.md. Retention itself (INACTIVE_DELETE_MONTHS=24,
      # INACTIVE_NOTICE_MONTHS=18,20,23, RETENTION_HOUR=4) has defaults.
      SMTP_HOST: ""
      SMTP_PORT: "587"
      SMTP_USER: ""
      SMTP_PASSWORD: ""
      SMTP_FROM: ""
      # Inactive-account retention (#113, entra mode only). Accounts nobody has
      # signed in to for INACTIVE_DELETE_MONTHS are deleted (0 = never), after a
      # notice email at each month in INACTIVE_NOTICE_MONTHS. These are the values
      # the privacy policy states - change both together. RETENTION_HOUR is the
      # local hour (per TZ) the daily run starts, after the backup.
      INACTIVE_DELETE_MONTHS: "24"
      INACTIVE_NOTICE_MONTHS: "18,20,23"
      RETENTION_HOUR: "4"
      # Backups (#5). The nightly copy goes under BACKUP_DIR (inside the /data
      # volume, so it survives restarts), at BACKUP_HOUR local time, and copies
      # older than BACKUP_KEEP_DAYS are pruned. Recommended: keep the defaults;
      # raise KEEP_DAYS if the dataset has room. Also snapshot the dataset itself.
      BACKUP_DIR: "/data/backups"
      BACKUP_KEEP_DAYS: "14"
      BACKUP_HOUR: "3"
      # Abuse limits (#71/#89). Set per person unless noted. Defaults suit a small
      # private group; tighten MAX_USERS / MAX_BYTES_PER_OWNER first if you open
      # signup (SIGNUP_MODE=open). Rate limits apply in entra mode only. 0 = off.
      MAX_USERS: "0"                       # total accounts; 0 = unlimited. Recommended for open signup: a cap you can afford, e.g. 100
      MAX_BYTES_PER_OWNER: "524288000"     # 500 MiB of JSON across all series one person owns
      MAX_SERIES_PER_OWNER: "200"
      MAX_RECORDS_PER_SERIES: "20000"
      WRITE_RATE_LIMIT_PER_MINUTE: "120"   # write requests; over it gets 429
      LOOKUP_RATE_LIMIT_PER_HOUR: "30"     # people look-ups by email when sharing
      FEEDBACK_RATE_LIMIT_PER_PERSON: "5"  # Log Issue/Suggestion filings per hour
      FEEDBACK_RATE_LIMIT_GLOBAL: "60"     # ...across everyone; keep well above the per-person cap
      # Request size caps in bytes. Keep the defaults; raise IMPORT_MAX_BODY_BYTES
      # only if a whole-bible import with many research images is rejected.
      MAX_BODY_BYTES: "5242880"            # 5 MiB
      IMPORT_MAX_BODY_BYTES: "20971520"    # 20 MiB, /api/import only
      # Leave off in production: /docs, /redoc and /openapi.json are unauthenticated (#68).
      ENABLE_API_DOCS: "false"
      # Database file (#5). No reason to change it in this container.
      STORYBIBLE_DB: "/data/storybible.db"
      # Content-Security-Policy header (#69). Not set here on purpose: blank/unset
      # uses the built-in policy, which is the recommended setting. Only add
      # CONTENT_SECURITY_POLICY if a Word host is blocked from loading something
      # ("off" removes just that header - not recommended).
    mem_limit: 512m
    # Hardening (#74). The app only ever writes to /data (the volume above) and
    # temp files; it needs no privileges and no extra capabilities. The CI
    # "Container starts and reports healthy" job runs the image with these same
    # settings, so a change that breaks them is caught there, not on the NAS.
    read_only: true
    tmpfs:
      # In-memory scratch space (counts toward mem_limit). Explicit size, so it's a
      # decision rather than a default: the app keeps request bodies in memory and
      # SQLite's temp files are small, so 128 MB is generous. If a huge library
      # ever hits "database or disk is full" during a backup, raise this.
      - /tmp:size=128m
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 256
    # No healthcheck block here - the image already defines one (see
    # Dockerfile's HEALTHCHECK); Docker uses it automatically.
