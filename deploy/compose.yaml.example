# Story Bible - TrueNAS SCALE Custom App template. This file is the
# generic, tracked-in-git template - DO NOT edit it in place with real
# values and DO NOT reference this filename directly for a persistent
# checkout (see deploy/README.md). It exists as:
#
#   - Something to paste into TrueNAS UI -> Apps -> Discover Apps ->
#     (top-right) Install via YAML, editing the values below IN THAT
#     PASTED TEXT (dataset path, STORYBIBLE_TOKEN, etc.) before installing.
#     That dialog doesn't accept a companion file (#36), hence everything
#     being inline in environment: below rather than an env_file:.
#   - The source for a ONE-TIME `cp deploy/compose.yaml.example
#     deploy/compose.yaml` on a persistent checkout (e.g. for
#     deploy/update.sh's `git pull`). deploy/compose.yaml is gitignored -
#     edit real values into THAT copy, never into this template. Keeping
#     the real file untracked is exactly what fixes #38: a tracked
#     deploy/compose.yaml with real values edited into it collides with
#     every future `git pull`, since git won't silently overwrite local
#     changes to a tracked file - which is what happened there.
#
# Either way: the image itself is built locally on the NAS by
# deploy/update.sh, not pulled from a registry - hence pull_policy: never,
# and why there's no `image:` tag with a registry prefix.
services:
  storybible:
    image: story-bible:current
    pull_policy: never
    restart: unless-stopped
    user: "568:568"          # TrueNAS SCALE's "apps" user - matches the dataset's owner
    ports:
      - "2285:8000"           # host:container - port 8000 on this NAS is already used elsewhere
    volumes:
      # The dataset itself, mounted directly as /data - not a subdirectory
      # under it. A subdirectory here wouldn't exist yet on first deploy,
      # so Docker would auto-create it owned by root, and the container
      # (running as 568:568) couldn't write to it. Mounting the dataset
      # root means the chown in deploy/README.md's step 1 is the only
      # ownership step needed. Adjust the path to your actual pool/dataset.
      - /mnt/tank/apps/storybible:/data
    environment:
      # Auth (see .env.example for what each of these does). Left blank,
      # STORYBIBLE_TOKEN is honestly wide open - app/main.py reports
      # "auth": false at /api/health and skips the check entirely - rather
      # than shipping a non-blank placeholder that would report "auth":
      # true while actually being a publicly-known value (this file is on
      # GitHub) anyone could authenticate with. Set a real one before
      # anything sensitive goes in:
      #   python -c "import secrets; print(secrets.token_urlsafe(32))"
      AUTH_MODE: token
      STORYBIBLE_TOKEN: ""
      ENTRA_TENANT_ID: ""
      ENTRA_CLIENT_ID: ""
      ALLOWED_OIDS: ""
      # The pane's "Log Issue"/"Log Suggestion" buttons (#22) - a
      # fine-grained GitHub PAT, scoped to just this repo, Issues: write
      # only. Blank means filing returns 503 rather than crashing.
      GITHUB_FEEDBACK_TOKEN: ""
      # The Synology reverse proxy's LAN IP - blank trusts nothing (127.0.0.1 default).
      FORWARDED_ALLOW_IPS: ""
      # Backup schedule/monitoring (#5/#17) and log timestamps.
      TZ: "Australia/Sydney"
      # Everything else (BACKUP_DIR, BACKUP_KEEP_DAYS, BACKUP_HOUR,
      # MAX_BODY_BYTES, STORYBIBLE_DB) has a sane default - add here only
      # to override.
    mem_limit: 512m
    # No healthcheck block here - the image already defines one (see
    # Dockerfile's HEALTHCHECK); Docker uses it automatically.
