# Reference for every setting the app reads - see deploy/README.md for the
# full TrueNAS setup this belongs to (#6).
#
# Not consumed automatically: real values go directly into
# deploy/compose.yaml's own environment: block instead (TrueNAS's "Install
# via YAML" installer doesn't accept a file alongside the pasted YAML -
# #36). deploy/compose.yaml is gitignored and created from the tracked
# deploy/compose.yaml.example template (deploy/update.sh does this on
# first run) - never edit real values into the .example file itself, or
# every future `git pull` collides with them (#38). Use this file as the
# reference for what each setting does.

# --- Authentication ---
# AUTH_MODE: "none", "token" or "entra" (#10). Defaults to "token" if
# STORYBIBLE_TOKEN is set below, else "none" - set it explicitly here so
# that default can't surprise you. Set a real token for "token" mode:
# without one, anyone on the LAN can read and delete every series.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_MODE=token
STORYBIBLE_TOKEN=

# Entra ID (horscrust.com tenant, #9) - required once AUTH_MODE=entra above.
# With SIGNUP_MODE=open this must be the home tenant's id (a GUID), not a domain.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# REQUIRED in entra mode with SIGNUP_MODE=allowlist (the server refuses to start
# without it; optional in open mode): a comma-separated allowlist of Entra object ids - defence in depth on top of
# Entra's own "assignment required". Set it to * to deliberately allow
# everyone Entra itself lets in (not recommended). Doesn't apply to the
# review pipeline's app-role token (#70).
ALLOWED_OIDS=
# The one Entra object id that should own any series created before sign-in
# existed (#11). Unset = nobody claims them (the server logs a warning at
# startup if any exist). Previously the first person to sign in got them (#70).
LEGACY_OWNER_OID=
# Comma-separated Entra object ids of the administrators: they get an Admin button
# in the pane to see registered users, their usage, and block/unblock people (#82).
# Object ids ONLY - never an email, which a signer's own tenant controls. Unset = no
# admin. Find yours on the Entra "Users" page, or from GET /api/me's `oid`.
ADMIN_OIDS=
# Who may sign in (#85/#90). "allowlist" (the default) is the single-tenant behaviour
# above: ALLOWED_OIDS is required. "open" accepts any Microsoft work/school account
# and personal account (multi-tenant "common" authority); ALLOWED_OIDS becomes
# optional (still enforced if set). Needs AUTH_MODE=entra. Do NOT set "open" until the
# go-live checklist in PLAN.md section 3 is done (Entra app registration, privacy
# policy and terms, delete-my-account, MAX_USERS below...). Roll back by setting it
# back to allowlist; people already registered keep their data.
SIGNUP_MODE=allowlist
# Open mode only: comma-separated tenant ids (GUIDs) refused with 403.
BLOCKED_TENANTS=
# Optional https links to the privacy policy and terms of use. When set, the pane's
# signed-out screen and the sign-in dialog show them before anyone's first sign-in.
PRIVACY_URL=
TERMS_URL=
# Version of the privacy policy and terms (shown on docs/privacy.html and terms.html).
# After signing in, people must accept the current version; bump this whenever the
# legal pages change and everyone is asked again. Entra mode only.
POLICY_VERSION=1.0

# --- Feedback (#22) - the pane's "Log Issue"/"Log Suggestion" buttons ---
# A fine-grained GitHub PAT, scoped to just this repo, with Issues: write
# permission only. Without one, filing returns 503 rather than crashing.
GITHUB_FEEDBACK_TOKEN=

# --- Networking ---
# The Synology reverse proxy's LAN IP, so its X-Forwarded-* headers are
# trusted - and only its. Defaults to 127.0.0.1 (trust nothing) if left
# blank. See deploy/README.md / #7.
FORWARDED_ALLOW_IPS=

# --- Backups (#5) - all optional, shown here with their defaults ---
# BACKUP_DIR=/data/backups
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=3

# --- Inactive accounts (#113) - entra mode only ---
# Accounts nobody has signed in to for INACTIVE_DELETE_MONTHS are deleted (0 = never),
# after an email at each of INACTIVE_NOTICE_MONTHS. Administrators are never deleted.
# These are the defaults, and what the privacy policy states - change both together.
# INACTIVE_DELETE_MONTHS=24
# INACTIVE_NOTICE_MONTHS=18,20,23
# RETENTION_HOUR=4   # local hour the daily run starts, after the backup

# --- Outgoing mail (#113) - the inactive-account notices ---
# Unset = no emails are sent (logged at startup); accounts are still deleted on schedule.
# For Gmail use an app password, never the account password - see deploy/README.md.
# Port 587 uses STARTTLS, 465 implicit TLS. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Misc ---
# STORYBIBLE_DB=/data/storybible.db   # the default - no reason to change it in this container
# Controls both the backup schedule's "local hour" and log timestamps.
# Confirm this is actually right for where the box lives - it's an example,
# not a value read from anywhere else in this repo.
TZ=Australia/Sydney

# CONTENT_SECURITY_POLICY=   # the Content-Security-Policy header (#69). Unset uses the built-in policy (see DEFAULT_CSP in app/main.py); "off" removes just that header. Only touch this if a Word host is blocked from loading something.
# ENABLE_API_DOCS=true   # serve /docs, /redoc and /openapi.json - UNAUTHENTICATED, so off by default (#68); for local development
# MAX_BODY_BYTES=5242880   # 5 MiB, the default - uncomment to change
# MAX_RECORDS_PER_SERIES=20000   # records (characters, places, events, ...) one series may hold (#71)
# MAX_SERIES_PER_OWNER=200   # series one person may own (#71)
# MAX_USERS=0   # cap on total accounts, 0 = unlimited (#89). Once reached, people who have never signed in are refused (403); existing accounts are unaffected
# MAX_BYTES_PER_OWNER=524288000   # 500 MiB, the default: JSON stored in all series one person owns, shared records included; 0 = off (#89)
# WRITE_RATE_LIMIT_PER_MINUTE=120   # per-person cap on write requests (AUTH_MODE=entra only); over it gets 429. 0 = off (#89)
# LOOKUP_RATE_LIMIT_PER_HOUR=30   # per-person cap on looking people up by email to share a series (AUTH_MODE=entra only); over it gets 429. 0 = off (#131)
# FEEDBACK_RATE_LIMIT_PER_PERSON=5   # "Log Issue"/"Log Suggestion" filings per person per hour (#89)
# FEEDBACK_RATE_LIMIT_GLOBAL=60   # ...and across everyone per hour; keep it well above the per-person cap so a few accounts can't lock the rest out (#89)
# IMPORT_MAX_BODY_BYTES=20971520   # 20 MiB, the default for /api/import specifically (#43: a whole-bible export can carry several research entries' embedded images)
