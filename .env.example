# Copy to `.env` next to deploy/compose.yaml and fill in. `.env` itself is
# gitignored - never commit real values (especially STORYBIBLE_TOKEN).
# See deploy/README.md for the full TrueNAS setup this belongs to (#6).

# --- Authentication ---
# AUTH_MODE isn't read by the app yet (Entra sign-in is #9/#10) - for now,
# auth is simply "on" whenever STORYBIBLE_TOKEN is set below, "off" if it's
# blank. Set a real token: without one, anyone on the LAN can read and
# delete every series. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_MODE=token
STORYBIBLE_TOKEN=

# Entra ID (horscrust.com tenant) - unused until AUTH_MODE=entra lands (#9/#10).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ALLOWED_OIDS=

# --- Networking ---
# The Synology reverse proxy's LAN IP, so its X-Forwarded-* headers are
# trusted - and only its. Defaults to 127.0.0.1 (trust nothing) if left
# blank. See deploy/README.md / #7.
FORWARDED_ALLOW_IPS=

# --- Backups (#5) - all optional, shown here with their defaults ---
# BACKUP_DIR=/data/backups
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=3

# --- Misc ---
# STORYBIBLE_DB=/data/storybible.db   # the default - no reason to change it in this container
# Controls both the backup schedule's "local hour" and log timestamps.
# Confirm this is actually right for where the box lives - it's an example,
# not a value read from anywhere else in this repo.
TZ=Australia/Sydney

# MAX_BODY_BYTES=5242880   # 5 MiB, the default - uncomment to change
